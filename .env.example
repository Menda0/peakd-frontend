# Generate AUTH0_SECRET: openssl rand -hex 32
# If credentials were exposed, rotate Auth0 application secret in the Auth0 Dashboard.
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
# Must match the origin you use in the browser (port included), e.g. http://localhost:3002 when using `next dev -p 3002`.
# Tenant domain only (no https://)
AUTH0_DOMAIN=YOUR_TENANT.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# API Identifier from Auth0 Dashboard → APIs (must match peakd-api AUTH0_AUDIENCE)
AUTH0_AUDIENCE=https://peakd-api
# Optional: Machine-to-Machine app (Auth0 Management API, scope read:user_roles) so the
# app can detect the “partner” role when it is missing from the access token. See
# peakd-frontend/auth0/post-login-add-roles-to-access-token.js for a token-only fix.
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=
# Optional; defaults to AUTH0_DOMAIN if unset (use when Management API uses another tenant host)
AUTH0_MANAGEMENT_DOMAIN=
# Server-side only: Nest API base URL for the BFF proxy (no trailing slash)
PEAKD_API_BASE_URL=http://localhost:3001
# Stripe webhook signing secret (Dashboard endpoint or `stripe listen` output — must match peakd-api)
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: separate signing secret for the Connect webhook endpoint (account.updated, payout.*).
# Falls back to STRIPE_WEBHOOK_SECRET if unset. Must match peakd-api STRIPE_CONNECT_WEBHOOK_SECRET.
STRIPE_CONNECT_WEBHOOK_SECRET=
# Must match peakd-api BILLING_WEBHOOK_INTERNAL_SECRET (openssl rand -hex 32)
BILLING_WEBHOOK_INTERNAL_SECRET=
