# Generate AUTH0_SECRET: openssl rand -hex 32
# If credentials were exposed, rotate Auth0 application secret in the Auth0 Dashboard.
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
# Must match the origin you use in the browser (port included), e.g. http://localhost:3002 when using `next dev -p 3002`.
# Tenant domain only (no https://)
AUTH0_DOMAIN=YOUR_TENANT.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# API Identifier from Auth0 Dashboard → APIs (must match peakd-api AUTH0_AUDIENCE)
AUTH0_AUDIENCE=https://peakd-api
# Server-side only: Nest API base URL for the BFF proxy (no trailing slash)
PEAKD_API_BASE_URL=http://localhost:3001
